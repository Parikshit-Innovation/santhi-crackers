{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "strictNullChecks": true,
    "paths": {
      "@repo/crackers": ["../../packages/crackers/index.ts"],
      "@repo/crackers/*": ["../../packages/crackers/*"],
      "@crackers": ["../../packages/crackers/index.ts"],
      "@crackers/*": ["../../packages/crackers/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}

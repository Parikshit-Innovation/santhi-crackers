{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/src/app.js",
  "exports": {
    ".": {
      "types": "./dist/src/app.d.ts",
      "import": "./dist/src/app.js",
      "default": "./dist/src/app.js"
    }
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names build,server \"tsc --watch --preserveWatchOutput\" \"tsx watch server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "check-types": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "admin:hash-password": "node scripts/hash-admin-password.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@repo/db": "*",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/node": "26.4.1",
    "@types/nodemailer": "^8.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "nodemailer": "^10.1.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6"
  }
}
